<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/channel_panel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:background="#161922"
        android:orientation="vertical"
        android:paddingTop="28dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:focusable="true"
        android:focusableInTouchMode="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/channel_panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp"
            android:text="CANAIS"
            android:textColor="#8B95AA"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />
    </LinearLayout>

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:focusable="false"
        android:focusableInTouchMode="false"
        app:use_controller="false"
        app:shutter_background_color="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/channel_panel"
        app:layout_constraintEnd_toEndOf="parent" />

    <WebView
        android:id="@+id/iframe_web_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/channel_panel"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/home_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#10131C"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:fontFamily="sans-serif-medium"
            android:text="TV BOX"
            android:textColor="#FFFFFF"
            android:textSize="25sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:letterSpacing="0.1"
            android:text="ESCOLHA UMA CATEGORIA"
            android:textColor="#8B95AA"
            android:textSize="13sp" />

        <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:gravity="center"
            android:rowCount="3">

            <TextView
                android:id="@+id/home_football"
                android:layout_width="165dp"
                android:layout_height="82dp"
                android:layout_margin="6dp"
                android:background="@drawable/home_category_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="⚽\nFUTEBOL"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/home_kick"
                android:layout_width="165dp"
                android:layout_height="82dp"
                android:layout_margin="6dp"
                android:background="@drawable/home_category_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="🎮\nKICK"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/home_movies"
                android:layout_width="165dp"
                android:layout_height="82dp"
                android:layout_margin="6dp"
                android:background="@drawable/home_category_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="🎬\nFILMES"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/home_series"
                android:layout_width="165dp"
                android:layout_height="82dp"
                android:layout_margin="6dp"
                android:background="@drawable/home_category_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="SÉRIES"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/home_update"
                android:layout_width="165dp"
                android:layout_height="58dp"
                android:layout_columnSpan="2"
                android:layout_margin="6dp"
                android:background="@drawable/home_category_background"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="ATUALIZAÇÕES"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </GridLayout>

        <TextView
            android:id="@+id/home_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif"
            android:textColor="#8B95AA"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/loading_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/loading_stadium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99061120" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminateTint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:text="CARREGANDO CANAIS"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
