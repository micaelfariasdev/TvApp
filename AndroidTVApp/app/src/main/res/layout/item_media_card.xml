<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="132dp" android:layout_height="206dp" android:layout_marginEnd="14dp"
    android:background="@drawable/media_card_background"
    android:foreground="@drawable/media_card_focus_foreground"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">
    <ImageView android:id="@+id/media_card_poster" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@null" android:scaleType="centerCrop" />
    <View android:layout_width="match_parent" android:layout_height="76dp" android:layout_gravity="bottom" android:background="@drawable/media_card_gradient" />
    <TextView android:id="@+id/media_card_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|start" android:layout_margin="8dp" android:background="#B3192230" android:paddingHorizontal="6dp" android:paddingVertical="3dp" android:textColor="#DCE7FF" android:textSize="9sp" />
    <TextView android:id="@+id/media_card_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_margin="10dp" android:maxLines="2" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
    <ProgressBar android:id="@+id/media_card_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_gravity="bottom" android:layout_marginStart="10dp" android:layout_marginEnd="10dp" android:layout_marginBottom="6dp" android:max="1000" android:progressTint="#35D07F" android:visibility="gone" />
</FrameLayout>
